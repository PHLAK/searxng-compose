# ------------------------------------------------------------------------------
# Container version overrides. Update these values and restart your containers
# (i.e. 'docker compose up -d') to update the versions of your services.
# ------------------------------------------------------------------------------

# SEARXNG_VERSION=latest

# ------------------------------------------------------------------------------
# The container ports to be exposed to the host.
# ------------------------------------------------------------------------------

# SEARXNG_PORT=8080

# ------------------------------------------------------------------------------
# Container data volumes. Absolute or relative path to the 'docker-compose.yaml'
# file or a named Docker volume. Defaults to a pre-configured, named volume.
# ------------------------------------------------------------------------------

# SEARXNG_DATA_VOLUME=searxng-data
# VALKEY_DATA_VOLUME=valkey-data
